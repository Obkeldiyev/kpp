generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Roles {
  ADMIN
  SUPERADMIN
  USER
  EMPLOYEE
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  INACTIVE
}

enum HikCentralDeviceType {
  ACCESS_CONTROL
  FACE_TERMINAL
  CAMERA
  DOOR
  UNKNOWN
}

enum HikCentralCredentialType {
  FACE
  CARD
  FINGERPRINT
  PIN
  QR
  UNKNOWN
}

enum HikCentralEventType {
  ACCESS_GRANTED
  ACCESS_DENIED
  FACE_RECOGNIZED
  FACE_NOT_RECOGNIZED
  CHECK_IN
  CHECK_OUT
  UNKNOWN
}

enum AttendanceDirection {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceAreaMode {
  CHECK_IN
  CHECK_OUT
  BOTH
  IGNORE
}

enum AttendanceCalculationMode {
  FIRST_IN_LAST_OUT
  EVERY_IN_OUT_PAIR
}

enum AttendanceShiftType {
  NORMAL
  FLEXIBLE
}

enum ScheduleTargetType {
  DEPARTMENT
  GROUP
  PERSON
  TEMPORARY
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE
}

enum PolicyStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum ApprovalType {
  LEAVE
  CHECK_IN_OUT_CORRECTION
  OVERTIME
  MOBILE_CHECK_IN_OUT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model SuperAdmin {
  id          String   @id @default(cuid())
  first_name  String
  second_name String
  username    String   @unique
  password    String
  role        Roles    @default(SUPERADMIN)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Admin {
  id               String                @id @default(cuid())
  first_name       String
  second_name      String
  username         String                @unique
  password         String
  role             Roles                 @default(ADMIN)
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt
  created_roles    AdminRole[]           @relation("AdminCreatedRoles")
  role_assignments AdminRoleAssignment[]
}

model Permission {
  id          String                @id @default(cuid())
  module      String
  action      PermissionAction
  description String?
  created_at  DateTime              @default(now())
  roles       AdminRolePermission[]

  @@unique([module, action])
  @@index([module])
}

model AdminRole {
  id             String                @id @default(cuid())
  name           String                @unique
  status         PolicyStatus          @default(ACTIVE)
  description    String?
  effective_from DateTime?
  effective_to   DateTime?
  created_by_id  String?
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt
  created_by     Admin?                @relation("AdminCreatedRoles", fields: [created_by_id], references: [id], onDelete: SetNull)
  permissions    AdminRolePermission[]
  assignments    AdminRoleAssignment[]

  @@index([created_by_id])
  @@index([status])
}

model AdminRolePermission {
  id            String     @id @default(cuid())
  role_id       String
  permission_id String
  role          AdminRole  @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([permission_id])
}

model AdminRoleAssignment {
  id          String    @id @default(cuid())
  admin_id    String
  role_id     String
  assigned_at DateTime  @default(now())
  admin       Admin     @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  role        AdminRole @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([admin_id, role_id])
  @@index([role_id])
}

model Company {
  id                 String             @id @default(cuid())
  name               String             @unique
  hikcentral_org_id  String?            @unique
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  areas              Area[]
  departments        Department[]
  users              User[]
  attendance_imports AttendanceImport[]
  access_levels      AccessLevel[]
}

model Department {
  id                   String               @id @default(cuid())
  name                 String
  path                 String
  hikcentral_org_id    String?              @unique
  parent_id            String?
  company_id           String
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  parent               Department?          @relation("DepartmentTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children             Department[]         @relation("DepartmentTree")
  company              Company              @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users                User[]
  access_groups        AccessGroup[]
  schedule_assignments ScheduleAssignment[]
  attendance_rules     AttendanceRule[]
  attendance_records   AttendanceRecord[]

  @@unique([company_id, path])
  @@index([company_id])
  @@index([parent_id])
}

model Area {
  id                 String   @id @default(cuid())
  name               String
  hikcentral_area_id String?  @unique
  company_id         String
  parent_id          String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  company            Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  parent             Area?    @relation("AreaTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children           Area[]   @relation("AreaTree")
  devices            Device[]

  @@unique([company_id, name, parent_id])
  @@index([company_id])
  @@index([parent_id])
}

model Device {
  id                   String                  @id @default(cuid())
  name                 String
  channel_address      String?
  chanel_address       String?
  device_address       String?
  device_name          String?
  hikcentral_device_id String?                 @unique
  type                 HikCentralDeviceType    @default(UNKNOWN)
  network_status       DeviceStatus            @default(OFFLINE)
  record_schedule      String?
  manufacturer         String?
  marking_status       String                  @default("unmarked")
  serial_number        String?
  ip_address           String?
  location             String?
  is_active            Boolean                 @default(true)
  raw                  Json?
  area_id              String?
  created_at           DateTime                @default(now())
  updated_at           DateTime                @updatedAt
  area                 Area?                   @relation(fields: [area_id], references: [id], onDelete: SetNull)
  pictures             DevicePicture[]
  access_points        HikCentralAccessPoint[]
  access_events        HikCentralAccessEvent[]

  @@index([area_id])
  @@index([type])
  @@index([network_status])
}

model DevicePicture {
  id          String   @id @default(cuid())
  device_id   String
  picture_url String
  created_at  DateTime @default(now())
  device      Device   @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([device_id])
}

model User {
  id                     String                      @id @default(cuid())
  id_number              String                      @unique
  identification         String?                     @unique
  hikcentral_person_id   String?                     @unique
  hikcentral_employee_no String?
  first_name             String
  second_name            String
  full_name              String?
  position               String?
  phone                  String?
  role                   Roles                       @default(USER)
  is_active              Boolean                     @default(true)
  company_id             String?
  department_id          String?
  created_at             DateTime                    @default(now())
  updated_at             DateTime                    @updatedAt
  company                Company?                    @relation(fields: [company_id], references: [id], onDelete: SetNull)
  department             Department?                 @relation(fields: [department_id], references: [id], onDelete: SetNull)
  images                 Images[]
  face_credentials       FaceCredential[]
  access_credentials     AccessCredential[]
  access_group_members   AccessGroupMember[]
  access_level_members   AccessLevelMember[]
  access_exceptions      PersonAccessException[]
  schedule_assignments   ScheduleAssignment[]
  approval_requests      AttendanceApprovalRequest[]
  access_events          HikCentralAccessEvent[]
  attendance_records     AttendanceRecord[]

  @@index([company_id])
  @@index([department_id])
  @@index([hikcentral_employee_no])
}

model Images {
  id                  String           @id @default(cuid())
  url                 String
  hikcentral_image_id String?          @unique
  is_primary_face     Boolean          @default(false)
  created_at          DateTime         @default(now())
  user_id             String
  user                User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  face_credentials    FaceCredential[]

  @@index([user_id])
}

model FaceCredential {
  id                 String    @id @default(cuid())
  hikcentral_face_id String?   @unique
  status             String    @default("ACTIVE")
  quality_score      Float?
  enrolled_at        DateTime?
  expires_at         DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  user_id            String
  image_id           String?
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  image              Images?   @relation(fields: [image_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([image_id])
}

model AccessCredential {
  id                       String                   @id @default(cuid())
  type                     HikCentralCredentialType
  value                    String
  hikcentral_credential_id String?                  @unique
  is_active                Boolean                  @default(true)
  issued_at                DateTime?
  expires_at               DateTime?
  created_at               DateTime                 @default(now())
  updated_at               DateTime                 @updatedAt
  user_id                  String
  user                     User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([user_id])
}

model HikCentralAccessPoint {
  id                  String                   @id @default(cuid())
  hikcentral_point_id String                   @unique
  name                String
  door_no             String?
  floor               String?
  location            String?
  device_id           String?
  created_at          DateTime                 @default(now())
  updated_at          DateTime                 @updatedAt
  device              Device?                  @relation(fields: [device_id], references: [id], onDelete: SetNull)
  access_events       HikCentralAccessEvent[]
  access_group_points AccessGroupAccessPoint[]
  access_level_points AccessLevelAccessPoint[]
  person_exceptions   PersonAccessException[]
  attendance_areas    AttendanceAreaRule[]

  @@index([device_id])
}

model AccessGroup {
  id                   String                   @id @default(cuid())
  name                 String
  description          String?
  status               PolicyStatus             @default(ACTIVE)
  hikcentral_group_id  String?                  @unique
  department_id        String?
  created_at           DateTime                 @default(now())
  updated_at           DateTime                 @updatedAt
  department           Department?              @relation(fields: [department_id], references: [id], onDelete: SetNull)
  members              AccessGroupMember[]
  access_points        AccessGroupAccessPoint[]
  access_level_members AccessLevelGroup[]
  schedule_assignments ScheduleAssignment[]

  @@unique([department_id, name])
  @@index([department_id])
  @@index([status])
}

model AccessLevel {
  id                  String                   @id @default(cuid())
  name                String
  description         String?
  status              PolicyStatus             @default(ACTIVE)
  hikcentral_level_id String?                  @unique
  starts_at           DateTime?
  ends_at             DateTime?
  company_id          String?
  created_at          DateTime                 @default(now())
  updated_at          DateTime                 @updatedAt
  company             Company?                 @relation(fields: [company_id], references: [id], onDelete: SetNull)
  people              AccessLevelMember[]
  groups              AccessLevelGroup[]
  access_points       AccessLevelAccessPoint[]

  @@unique([company_id, name])
  @@index([company_id])
  @@index([status])
}

model AccessLevelMember {
  id              String      @id @default(cuid())
  access_level_id String
  user_id         String
  starts_at       DateTime?
  ends_at         DateTime?
  created_at      DateTime    @default(now())
  access_level    AccessLevel @relation(fields: [access_level_id], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([access_level_id, user_id])
  @@index([user_id])
}

model AccessLevelGroup {
  id              String      @id @default(cuid())
  access_level_id String
  access_group_id String
  created_at      DateTime    @default(now())
  access_level    AccessLevel @relation(fields: [access_level_id], references: [id], onDelete: Cascade)
  access_group    AccessGroup @relation(fields: [access_group_id], references: [id], onDelete: Cascade)

  @@unique([access_level_id, access_group_id])
  @@index([access_group_id])
}

model AccessLevelAccessPoint {
  id              String                @id @default(cuid())
  access_level_id String
  access_point_id String
  can_enter       Boolean               @default(true)
  can_exit        Boolean               @default(true)
  starts_at       DateTime?
  ends_at         DateTime?
  created_at      DateTime              @default(now())
  access_level    AccessLevel           @relation(fields: [access_level_id], references: [id], onDelete: Cascade)
  access_point    HikCentralAccessPoint @relation(fields: [access_point_id], references: [id], onDelete: Cascade)

  @@unique([access_level_id, access_point_id])
  @@index([access_point_id])
}

model AccessGroupMember {
  id              String      @id @default(cuid())
  user_id         String
  access_group_id String
  starts_at       DateTime?
  ends_at         DateTime?
  created_at      DateTime    @default(now())
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  access_group    AccessGroup @relation(fields: [access_group_id], references: [id], onDelete: Cascade)

  @@unique([user_id, access_group_id])
  @@index([access_group_id])
}

model AccessGroupAccessPoint {
  id              String                @id @default(cuid())
  access_group_id String
  access_point_id String
  can_enter       Boolean               @default(true)
  can_exit        Boolean               @default(true)
  created_at      DateTime              @default(now())
  access_group    AccessGroup           @relation(fields: [access_group_id], references: [id], onDelete: Cascade)
  access_point    HikCentralAccessPoint @relation(fields: [access_point_id], references: [id], onDelete: Cascade)

  @@unique([access_group_id, access_point_id])
  @@index([access_point_id])
}

model PersonAccessException {
  id              String                @id @default(cuid())
  user_id         String
  access_point_id String
  allow_access    Boolean
  reason          String?
  starts_at       DateTime?
  ends_at         DateTime?
  created_at      DateTime              @default(now())
  user            User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  access_point    HikCentralAccessPoint @relation(fields: [access_point_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([access_point_id])
}

model AttendanceScheduleTemplate {
  id           String                  @id @default(cuid())
  name         String                  @unique
  type         AttendanceShiftType     @default(NORMAL)
  working_time String?
  break_period String?
  color        String?
  description  String?
  created_at   DateTime                @default(now())
  updated_at   DateTime                @updatedAt
  days         AttendanceScheduleDay[]
  rules        AttendanceRule[]
  shifts       AttendanceShift[]
  assignments  ScheduleAssignment[]
}

model AttendanceScheduleDay {
  id             String                     @id @default(cuid())
  template_id    String
  week_day       WeekDay
  is_working_day Boolean                    @default(true)
  start_time     String?
  end_time       String?
  break_minutes  Int                        @default(0)
  template       AttendanceScheduleTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@unique([template_id, week_day])
}

model AttendanceRule {
  id                     String                      @id @default(cuid())
  name                   String
  description            String?
  is_global              Boolean                     @default(false)
  department_id          String?
  schedule_template_id   String?
  calculation_mode       AttendanceCalculationMode   @default(FIRST_IN_LAST_OUT)
  late_after_minutes     Int                         @default(0)
  early_leave_minutes    Int                         @default(0)
  overtime_after_minutes Int                         @default(0)
  weekends               WeekDay[]
  is_active              Boolean                     @default(true)
  created_at             DateTime                    @default(now())
  updated_at             DateTime                    @updatedAt
  department             Department?                 @relation(fields: [department_id], references: [id], onDelete: Cascade)
  schedule_template      AttendanceScheduleTemplate? @relation(fields: [schedule_template_id], references: [id], onDelete: SetNull)
  area_rules             AttendanceAreaRule[]

  @@index([department_id])
  @@index([is_global])
  @@index([is_active])
}

model AttendanceShift {
  id                   String                      @id @default(cuid())
  name                 String
  code                 String?
  type                 AttendanceShiftType         @default(NORMAL)
  start_time           String
  end_time             String
  break_minutes        Int                         @default(0)
  color                String?
  schedule_template_id String?
  created_at           DateTime                    @default(now())
  updated_at           DateTime                    @updatedAt
  schedule_template    AttendanceScheduleTemplate? @relation(fields: [schedule_template_id], references: [id], onDelete: SetNull)
  assignments          ScheduleAssignment[]

  @@unique([name, code])
  @@index([schedule_template_id])
}

model ScheduleAssignment {
  id                     String                      @id @default(cuid())
  target_type            ScheduleTargetType
  starts_at              DateTime
  ends_at                DateTime?
  attendance_check_point String?                     @default("All")
  department_id          String?
  access_group_id        String?
  user_id                String?
  schedule_template_id   String?
  shift_id               String?
  created_at             DateTime                    @default(now())
  updated_at             DateTime                    @updatedAt
  department             Department?                 @relation(fields: [department_id], references: [id], onDelete: Cascade)
  access_group           AccessGroup?                @relation(fields: [access_group_id], references: [id], onDelete: Cascade)
  user                   User?                       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  schedule_template      AttendanceScheduleTemplate? @relation(fields: [schedule_template_id], references: [id], onDelete: SetNull)
  shift                  AttendanceShift?            @relation(fields: [shift_id], references: [id], onDelete: SetNull)

  @@index([target_type])
  @@index([department_id])
  @@index([access_group_id])
  @@index([user_id])
  @@index([starts_at, ends_at])
}

model AttendanceAreaRule {
  id                 String                @id @default(cuid())
  attendance_rule_id String
  access_point_id    String
  mode               AttendanceAreaMode    @default(BOTH)
  created_at         DateTime              @default(now())
  attendance_rule    AttendanceRule        @relation(fields: [attendance_rule_id], references: [id], onDelete: Cascade)
  access_point       HikCentralAccessPoint @relation(fields: [access_point_id], references: [id], onDelete: Cascade)

  @@unique([attendance_rule_id, access_point_id])
  @@index([access_point_id])
}

model HikCentralAccessEvent {
  id                       String                   @id @default(cuid())
  hikcentral_event_id      String?                  @unique
  event_type               HikCentralEventType      @default(UNKNOWN)
  credential_type          HikCentralCredentialType @default(UNKNOWN)
  direction                AttendanceDirection?
  event_time               DateTime
  person_external_id       String?
  person_name              String?
  card_no                  String?
  temperature              Float?
  skin_surface_temperature String?
  temperature_status       String?
  card_swiping_type        String?
  verification_mode        String?
  attendance_group         String?
  success                  Boolean?
  message                  String?
  raw                      Json?
  received_at              DateTime                 @default(now())
  user_id                  String?
  device_id                String?
  access_point_id          String?
  user                     User?                    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  device                   Device?                  @relation(fields: [device_id], references: [id], onDelete: SetNull)
  access_point             HikCentralAccessPoint?   @relation(fields: [access_point_id], references: [id], onDelete: SetNull)

  @@index([event_time])
  @@index([user_id, event_time])
  @@index([person_external_id])
  @@index([device_id])
  @@index([access_point_id])
}

model AttendanceImport {
  id           String             @id @default(cuid())
  file_name    String
  report_name  String?
  operator     String?
  exported_at  DateTime?
  period_start DateTime?
  period_end   DateTime?
  source       String             @default("HIKCENTRAL_EXCEL")
  status       SyncStatus         @default(SUCCESS)
  raw          Json?
  created_at   DateTime           @default(now())
  company_id   String?
  company      Company?           @relation(fields: [company_id], references: [id], onDelete: SetNull)
  records      AttendanceRecord[]

  @@index([company_id])
  @@index([period_start, period_end])
}

model AttendanceRecord {
  id                      String            @id @default(cuid())
  person_code             String?
  identifier              String?
  first_name              String?
  second_name             String?
  full_name               String?
  department_path         String?
  attendance_group        String?
  time_group              String?
  position                String?
  work_date               DateTime
  week_day                String?
  period_name             String?
  required_check_in_date  DateTime?
  required_check_in_time  String?
  required_check_out_date DateTime?
  required_check_out_time String?
  check_in_at             DateTime?
  check_out_at            DateTime?
  check_in_time           String?
  check_out_time          String?
  duration_minutes        Int?
  total_duration_minutes  Int?
  raw                     Json?
  created_at              DateTime          @default(now())
  updated_at              DateTime          @updatedAt
  user_id                 String?
  department_id           String?
  import_id               String?
  user                    User?             @relation(fields: [user_id], references: [id], onDelete: SetNull)
  department              Department?       @relation(fields: [department_id], references: [id], onDelete: SetNull)
  import                  AttendanceImport? @relation(fields: [import_id], references: [id], onDelete: Cascade)

  @@unique([identifier, work_date, period_name])
  @@index([user_id, work_date])
  @@index([department_id, work_date])
  @@index([import_id])
  @@index([work_date])
}

model AttendanceApprovalRequest {
  id            String         @id @default(cuid())
  type          ApprovalType
  status        ApprovalStatus @default(PENDING)
  reason        String?
  starts_at     DateTime?
  ends_at       DateTime?
  requested_at  DateTime       @default(now())
  decided_at    DateTime?
  decision_note String?
  raw           Json?
  user_id       String
  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([type, status])
  @@index([requested_at])
}

model HikCentralSyncJob {
  id            String     @id @default(cuid())
  job_type      String
  status        SyncStatus @default(PENDING)
  started_at    DateTime?
  finished_at   DateTime?
  last_cursor   String?
  error_message String?
  raw           Json?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  @@index([job_type, status])
}
